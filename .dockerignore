# Keep the Docker build context (repo root) small and free of local scratch/build
# artifacts and secrets. Backend and frontend both build from the root context.
.git
.gitignore
.github
ARCHITECTURE.md
README.md
ROADMAP.md
CONTRIBUTING.md
deploy
scripts

# dependencies + build output (reinstalled/rebuilt inside the image)
node_modules
**/node_modules
backend/dist
frontend/dist

# test + audit output (regenerated locally; nothing in an image needs it)
**/coverage
test-results
playwright-report
.playwright-mcp
e2e

# secrets / local env
**/.env
**/.env.local
**/.env.*.local

**/*.log
**/.DS_Store
