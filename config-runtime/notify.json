{
  "channels": [
    {
      "id": "ops-wecom",
      "type": "wecom",
      "enabled": true,
      "urlEnv": "NOTIFY_WECOM_URL",
      "severities": ["critical"],
      "scope": {
        "formationIds": [
          "warehouse-beta",
          "cold-chain",
          "assembly-delta",
          "cloudpoint-demo-team"
        ]
      },
      "escalation": {
        "afterSeconds": 600,
        "channelId": "yard-dingtalk"
      }
    },
    {
      "id": "yard-dingtalk",
      "type": "dingtalk",
      "enabled": true,
      "urlEnv": "NOTIFY_DINGTALK_URL",
      "severities": ["critical", "warning"],
      "scope": {
        "tags": ["室外"]
      },
      "renotifySeconds": 600
    },
    {
      "id": "ops-email",
      "type": "email",
      "enabled": true,
      "urlEnv": "NOTIFY_SMTP_URL",
      "severities": ["critical", "warning"],
      "from": "navfleet@example.com",
      "recipients": [
        {
          "email": "ops@example.com"
        }
      ],
      "groups": ["oncall"],
      "digestSeconds": 900,
      "digestSeverities": ["warning"],
      "silenceWindows": [
        {
          "days": [0, 6],
          "from": "22:00",
          "to": "07:00"
        },
        {
          "from": "12:00",
          "to": "13:30"
        }
      ]
    },
    {
      "id": "ticket-webhook",
      "type": "webhook",
      "enabled": true,
      "urlEnv": "NOTIFY_TICKET_WEBHOOK_URL",
      "severities": ["critical"]
    },
    {
      "id": "vendor-webhook",
      "type": "webhook",
      "enabled": true,
      "urlEnv": "NOTIFY_VENDOR_WEBHOOK_URL",
      "severities": ["critical", "warning", "notice"],
      "scope": {
        "deviceIds": ["agv-y08", "seer-test-07"]
      }
    },
    {
      "id": "sms-gateway",
      "type": "webhook",
      "enabled": true,
      "urlEnv": "NOTIFY_SMS_WEBHOOK_URL",
      "severities": ["critical"],
      "scope": {
        "tags": ["冷库"]
      }
    },
    {
      "id": "dev-webhook",
      "type": "webhook",
      "enabled": false,
      "urlEnv": "NOTIFY_DEV_WEBHOOK_URL",
      "severities": []
    }
  ],
  "groups": {
    "oncall": [
      {
        "user": "zhaoyun"
      },
      {
        "user": "qianwei"
      },
      {
        "email": "oncall@example.com"
      }
    ],
    "managers": [
      {
        "user": "lifang"
      },
      {
        "email": "manager@example.com"
      }
    ]
  }
}
