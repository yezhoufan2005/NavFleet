{
  "name": "navfleet",
  "version": "1.0.2",
  "private": true,
  "description": "NavFleet — read-only real-time fleet monitoring platform (monorepo root).",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "frontend-next"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:e2e",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "npm run lint --workspaces --if-present && npm run lint:e2e",
    "lint:e2e": "eslint e2e",
    "lint:fix": "npm run lint:fix --workspaces --if-present && eslint e2e --fix",
    "format:check": "npm run format:check --workspaces --if-present && prettier --check \"e2e/**/*.{ts,json}\"",
    "format:e2e": "prettier --write \"e2e/**/*.{ts,json}\"",
    "test": "npm run test --workspaces --if-present",
    "check:map-contrast": "node docs/tools/check-map-contrast.mjs",
    "e2e": "npm run e2e:install && playwright test -c e2e",
    "e2e:ui": "npm run e2e:install && playwright test -c e2e --ui",
    "build": "npm run build -w @navfleet/shared --if-present && npm run build -w navfleet-backend && npm run build -w navfleet-frontend && npm run build -w navfleet-console",
    "dev:backend": "npm run dev -w navfleet-backend",
    "dev:frontend": "npm run dev -w navfleet-frontend",
    "mock:mqtt": "npm run mock:mqtt -w navfleet-backend",
    "e2e:install": "playwright install chromium",
    "dev:console": "npm run dev -w navfleet-console"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{ts,js,vue,json,md,yml,yaml,css}": "prettier --write"
  }
}
