{
  "name": "@navfleet/fleet-core",
  "private": true,
  "license": "MIT",
  "description": "Framework-free fleet logic — normalization, the REST client, enums and formatters. Shared by both frontends so the two cannot drift apart.",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@navfleet/shared": "*"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "*",
    "eslint-config-prettier": "*",
    "globals": "*",
    "prettier": "*",
    "typescript": "^5.9.3",
    "typescript-eslint": "*",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
