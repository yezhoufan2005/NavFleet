{
  "name": "navfleet-console",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "NavFleet console — the v3 frontend, and the one compose deploys by default.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 7070",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && node scripts/assert-no-dev-only-chunks.mjs && node scripts/assert-first-load-budget.mjs",
    "preview": "vite preview --port 4273",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@navfleet/fleet-core": "*",
    "@navfleet/shared": "*",
    "echarts": "^6.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "*",
    "eslint-config-prettier": "*",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "*",
    "jsdom": "^30.1.3",
    "prettier": "*",
    "tailwindcss": "^4.3.3",
    "typescript": "*",
    "typescript-eslint": "*",
    "vite": "^8.3.5",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
