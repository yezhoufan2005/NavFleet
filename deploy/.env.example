# Web entry. Use 80 in production if the host port is free.
HTTP_HOST_PORT=8080

# MQTT broker exposed by the compose stack.
MQTT_HOST_PORT=1883
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PATTERN=/fleet/{deviceId}/vehicle_info

# Backend runtime.
PORT=3000
FLEET_NAME=多车监控平台
OFFLINE_AFTER_SECONDS=60
TELEMETRY_RETENTION_SECONDS=2592000
ALERTS_RETENTION_SECONDS=15552000
MAX_HISTORY_POINTS=500
MONGO_BUFFER_LIMIT=2000
SEED_FILE=

# Runtime configuration directory mounted into backend.
CONFIG_ROOT_PATH=/runtime-config
CONFIG_RUNTIME_HOST_PATH=../config-runtime
CONFIG_WATCH_USE_POLLING=false
CONFIG_WATCH_DEBOUNCE_MS=1000

# MongoDB. Change passwords before internet-facing deployment.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_URI=mongodb://root:example@mongo:27017/fleet_monitor?authSource=admin
MONGO_DB_NAME=fleet_monitor

# Optional AMap browser keys. These are build-time values for the frontend image.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=
