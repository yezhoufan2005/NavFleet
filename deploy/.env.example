# NavFleet — Docker Compose 环境变量示例
# 复制为 deploy/.env 后按需修改。标注「生产必改」的项在对外部署前务必设置。

# Web 入口端口（宿主机）。生产可用 80（若空闲）。
HTTP_HOST_PORT=8080
# 仅 TLS 叠加编排（docker-compose.tls.yml）使用；HTTP 会 308 跳转到这里。
HTTPS_HOST_PORT=443

# 运行环境：production 会启用更严格的校验（如缺少 JWT_SECRET 直接启动失败）。
NODE_ENV=production

# ---------------------------------------------------------------------------
# 鉴权（生产必改）
# ---------------------------------------------------------------------------
# 是否启用登录与 RBAC。仅本地实验可设 false，其余场景保持 true。
AUTH_ENABLED=true
# 【生产必改】JWT 签名密钥，需为足够长的随机串。留空则使用进程内临时密钥，
# 后端每次重启都会使所有会话失效。生成示例：openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10
# 初始管理员账号。首次启动按此创建/更新。
ADMIN_USERNAME=admin
# 【生产必改】管理员密码。留空时：开发环境会以默认口令 admin123 创建并告警，
# production 环境则拒绝创建默认管理员。请设置强口令。
ADMIN_PASSWORD=
# 经 HTTPS 提供服务时设为 true，使鉴权 Cookie 带 Secure 标记。
COOKIE_SECURE=false
# 允许的跨域浏览器来源（逗号分隔）。同源 nginx 部署可留空使用默认。
CORS_ORIGINS=
# 允许设置 X-Forwarded-For 的反向代理跳数。本 compose 前面有一层 nginx，故为 1；
# 若留 0，限流会把所有请求都算到 nginx 自己的地址上（整个部署共用一个额度）。
TRUST_PROXY=1
# /api 整体的每 IP 粗粒度限流（登录路由另有更严的限制）。
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# ---------------------------------------------------------------------------
# 车队与 MQTT
# ---------------------------------------------------------------------------
FLEET_NAME=智能车队
# broker 端口，只绑定在宿主机 127.0.0.1（供本机 `npm run mock:mqtt` 演示用）。
# 生产若发布端都是远程车辆，可直接删掉 compose 里的这段 ports 映射：后端是走
# 容器内的 bus 网络连 broker 的，不依赖宿主机端口。
MQTT_HOST_PORT=1883
MQTT_URL=mqtt://mosquitto:1883
# 【必填】broker 已关闭匿名访问。两个账号在容器启动时由 entrypoint.sh 用
# mosquitto_passwd 现场生成并写入 ACL，密码不进仓库；改了密码重启即轮换。
# 订阅方（后端）只有读权限，发布方（车辆/模拟器）只有写权限：任一凭据泄露都做不了
# 对方的事。
MQTT_SUBSCRIBER_USERNAME=navfleet-backend
MQTT_SUBSCRIBER_PASSWORD=
MQTT_PUBLISHER_USERNAME=navfleet-publisher
MQTT_PUBLISHER_PASSWORD=
# ACL 覆盖的主题子树，需与 MQTT_TOPIC_PATTERN 的根一致。
MQTT_ACL_TOPIC_PATTERN=/fleet/#
# 遥测主题模板；{deviceId} 为占位符，后端据此派生 +/vehicle_info 与 +/status。
MQTT_TOPIC_PATTERN=/fleet/{deviceId}/vehicle_info
# 可选：固定 MQTT 客户端 ID，留空则随机生成。
MQTT_CLIENT_ID=

# ---------------------------------------------------------------------------
# 后端运行参数
# ---------------------------------------------------------------------------
PORT=3000
OFFLINE_AFTER_SECONDS=60
TELEMETRY_RETENTION_SECONDS=2592000
ALERTS_RETENTION_SECONDS=15552000
MAX_HISTORY_POINTS=500
MONGO_BUFFER_LIMIT=2000
SEED_FILE=

# 运行期配置目录（挂载进后端容器）。
CONFIG_ROOT_PATH=/runtime-config
CONFIG_RUNTIME_HOST_PATH=../config-runtime
CONFIG_WATCH_USE_POLLING=false
CONFIG_WATCH_DEBOUNCE_MS=1000

# ---------------------------------------------------------------------------
# 可观测性
# ---------------------------------------------------------------------------
# pino 日志级别：trace|debug|info|warn|error|fatal。
LOG_LEVEL=info
# 暴露 GET /metrics（Prometheus 文本，未鉴权）。边缘 nginx **不再**代理该路径，
# 抓取方需在 compose 网络内访问 backend:3000/metrics。
METRICS_ENABLED=true
# 调试注入端点，默认关闭；仅测试时开启（且需 admin）。
DEBUG_INGEST_ENABLED=false

# ---------------------------------------------------------------------------
# 监控叠加文件（deploy/docker-compose.monitoring.yml）
# ---------------------------------------------------------------------------
# 【用监控叠加文件时必填】Grafana 管理员口令。留空时 compose 拒绝启动，
# 而不是起一个 admin/admin 的面板。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_HOST_PORT=3001
# Prometheus 查询接口未鉴权，只绑定在 127.0.0.1。
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=15d

# ---------------------------------------------------------------------------
# 备份叠加文件（deploy/docker-compose.backup.yml）
# ---------------------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# 归档写到宿主机的哪个目录（相对 deploy/）。
BACKUP_HOST_PATH=./backups

# ---------------------------------------------------------------------------
# MongoDB（生产必改密码）
# ---------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-in-production
MONGO_URI=mongodb://root:change-me-in-production@mongo:27017/fleet_monitor?authSource=admin
MONGO_DB_NAME=fleet_monitor

# ---------------------------------------------------------------------------
# 高德地图（前端构建期注入，可选）
# ---------------------------------------------------------------------------
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=
