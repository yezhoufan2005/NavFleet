PORT=3000
FLEET_NAME=智能车队
MQTT_URL=mqtt://127.0.0.1:1883
# Telemetry topic template. {deviceId} is a placeholder; the backend subscribes
# to /fleet/+/vehicle_info and /fleet/+/status. Keep this consistent with the
# actual subscription topics in src/index.ts.
MQTT_TOPIC_PATTERN=/fleet/{deviceId}/vehicle_info
# Leave blank for an anonymous broker (default). Set real credentials via your
# deployment secret store — do not commit them here.
MQTT_USERNAME=
MQTT_PASSWORD=
MONGO_URI=mongodb://127.0.0.1:27017/fleet_monitor
MONGO_DB_NAME=fleet_monitor
SEED_FILE=
OFFLINE_AFTER_SECONDS=60
TELEMETRY_RETENTION_SECONDS=2592000
ALERTS_RETENTION_SECONDS=15552000
MAX_HISTORY_POINTS=500
MONGO_BUFFER_LIMIT=2000
CONFIG_ROOT_PATH=../config-runtime
CONFIG_WATCH_USE_POLLING=false
CONFIG_WATCH_DEBOUNCE_MS=1000

# --- Auth (Phase 2) ---
# Set AUTH_ENABLED=false only for local experiments; leave true otherwise.
AUTH_ENABLED=true
# REQUIRED in production: a long random string. If unset, an ephemeral secret is
# used and all tokens are invalidated on restart.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10
# Initial administrator, seeded on startup. Change ADMIN_PASSWORD before first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set true when serving over HTTPS so auth cookies get the Secure flag.
COOKIE_SECURE=false
# Comma-separated allowed browser origins for cross-origin API calls (dev only;
# same-origin nginx deployments can leave the default).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# The debug ingest endpoint is disabled by default; enable only for testing.
# NODE_ENV=production refuses to start with this on.
DEBUG_INGEST_ENABLED=false
# Reverse-proxy hops allowed to set X-Forwarded-For. 0 = ignore the header, the
# safe default for a directly exposed backend. Behind one nginx, set 1 — without
# it every request is rate-limited under the proxy's own address, so the whole
# deployment shares a single bucket.
TRUST_PROXY=0
# Coarse per-IP limit for the whole /api surface (the login route keeps its own,
# tighter limit). Live data arrives over one WebSocket, so a real session needs
# very few REST calls.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# --- Observability (Phase 4) ---
# pino log level: trace|debug|info|warn|error|fatal (default info).
LOG_LEVEL=info
# Exposes GET /metrics in Prometheus text format. Intended for INTERNAL scraping
# only (it is unauthenticated) — firewall it or set METRICS_ENABLED=false if the
# port is reachable from untrusted networks. Liveness /health and readiness
# /health/ready are always public.
METRICS_ENABLED=true
